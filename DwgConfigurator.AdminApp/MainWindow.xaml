<Window x:Class="DwgConfigurator.AdminApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:DwgConfigurator.AdminApp.Views"
        Title="DWG Configurator - Admin" Width="1320" Height="750" MinWidth="1200" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="Admin - Gestione Configurazioni"
                   FontSize="20" FontWeight="Bold" Foreground="#333" Margin="8,4,0,8"/>
        <TabControl Grid.Row="1" Margin="4" x:Name="MainTabControl"
                    SelectionChanged="MainTabControl_SelectionChanged">
            <TabItem Header="Gamma / Configurazioni">
                <views:ProductTypesView/>
            </TabItem>
            <TabItem Header="Attributi Fissi">
                <views:FixedAttributesView x:Name="FixedAttributesTab"/>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
