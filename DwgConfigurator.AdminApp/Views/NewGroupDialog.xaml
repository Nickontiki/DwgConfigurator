<Window x:Class="DwgConfigurator.AdminApp.Views.NewGroupDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nuova Gamma" Width="500" Height="230"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Row="0" Text="Nome:" VerticalAlignment="Center" Margin="0,0,8,8" FontWeight="SemiBold"/>
        <TextBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" x:Name="txtName" Height="30" Margin="0,0,0,8"/>
        <TextBlock Grid.Row="1" Text="Cartiglio:" VerticalAlignment="Center" Margin="0,0,8,8" FontWeight="SemiBold"/>
        <TextBox Grid.Row="1" Grid.Column="1" x:Name="txtCartiglio" Height="30" IsReadOnly="True" Background="#F7F7F7" Margin="0,0,8,8"/>
        <Button Grid.Row="1" Grid.Column="2" Content="📂" Click="BrowseCartiglio_Click" Width="36" Height="30" Margin="0,0,0,8"/>
        <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="OK" Click="OK_Click" Width="90" Height="30" Margin="0,0,8,0" IsDefault="True"/>
            <Button Content="Annulla" Click="Cancel_Click" Width="90" Height="30" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
