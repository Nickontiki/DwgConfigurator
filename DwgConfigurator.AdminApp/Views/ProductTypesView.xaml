<UserControl x:Class="DwgConfigurator.AdminApp.Views.ProductTypesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DwgConfigurator.AdminApp.ViewModels">
    <UserControl.DataContext>
        <vm:ProductTypeViewModel />
    </UserControl.DataContext>

    <UserControl.Resources>
        <Style x:Key="LabelText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#333"/>
        </Style>
        <Style x:Key="InputBox" TargetType="Control">
            <Setter Property="Height" Value="30"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>
        <Style x:Key="BaseButton" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="Padding" Value="12,4"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="MinWidth" Value="36"/>
            <Setter Property="Width" Value="36"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Foreground" Value="#C50F1F"/>
            <Setter Property="MinWidth" Value="130"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <GroupBox Grid.Row="0" Header="📁 Gamma e Modulo" Margin="0,0,0,10">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Gamma:" Style="{StaticResource LabelText}"/>
                <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding Groups}" SelectedItem="{Binding SelectedGroup}"
                          DisplayMemberPath="Name" Style="{StaticResource InputBox}"/>
                <Button Grid.Row="0" Grid.Column="2" Content="➕ Nuova Gamma" Command="{Binding NewGroupCommand}" Style="{StaticResource BaseButton}"/>

                <TextBlock Grid.Row="0" Grid.Column="4" Text="Modulo:" Style="{StaticResource LabelText}"/>
                <ComboBox Grid.Row="0" Grid.Column="5" ItemsSource="{Binding ModuleOptions}" SelectedItem="{Binding SelectedModuleOption}"
                          Style="{StaticResource InputBox}"/>
                <Button Grid.Row="0" Grid.Column="6" Content="🗑 Elimina Modulo" Command="{Binding DeleteModuleCommand}" Style="{StaticResource DangerButton}"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Nome:" Style="{StaticResource LabelText}"/>
                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding SelectedGroup.Name, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource InputBox}"/>

                <TextBlock Grid.Row="2" Grid.Column="4" Text="Cartiglio:" Style="{StaticResource LabelText}"/>
                <Grid Grid.Row="2" Grid.Column="5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Text="{Binding SelectedGroup.CartiglioPath, Mode=OneWay}" IsReadOnly="True"
                             Background="#F7F7F7" ToolTip="{Binding SelectedGroup.CartiglioPath}" Style="{StaticResource InputBox}"/>
                    <Button Grid.Column="1" Content="📂" Command="{Binding BrowseCartiglioCommand}" Style="{StaticResource IconButton}"/>
                </Grid>
                <StackPanel Grid.Row="2" Grid.Column="6" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="💾 Salva" Command="{Binding SaveGroupCommand}" Style="{StaticResource BaseButton}" MinWidth="95"/>
                    <Button Content="🗑 Elimina" Command="{Binding DeleteGroupCommand}" Style="{StaticResource DangerButton}" MinWidth="95"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <GroupBox Grid.Row="1" Header="➕ Nuova configurazione nel modulo selezionato" Margin="0,0,0,10">
            <Grid Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="45"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="60"/>
                    <ColumnDefinition Width="88"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Famiglia:" Style="{StaticResource LabelText}"/>
                <TextBox Grid.Column="1" Text="{Binding NewFamiglia, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputBox}"/>
                <TextBlock Grid.Column="2" Text="Carpenteria:" Style="{StaticResource LabelText}"/>
                <TextBox Grid.Column="3" Text="{Binding NewCarpenteria, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputBox}"/>
                <TextBlock Grid.Column="4" Text="T °C:" Style="{StaticResource LabelText}"/>
                <ComboBox Grid.Column="5" ItemsSource="{Binding TemperatureOptions}" SelectedItem="{Binding NewTemperatura}" Style="{StaticResource InputBox}"/>
                <TextBlock Grid.Column="6" Text="Layout:" Style="{StaticResource LabelText}"/>
                <TextBox Grid.Column="7" Text="{Binding NewLayoutPath, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True"
                         ToolTip="{Binding NewLayoutPath}" HorizontalScrollBarVisibility="Auto"
                         Background="#F7F7F7" Style="{StaticResource InputBox}"/>
                <Button Grid.Column="8" Content="📂" Command="{Binding BrowseNewLayoutCommand}" Style="{StaticResource IconButton}"/>
                <TextBlock Grid.Column="9" Text="Formato:" Style="{StaticResource LabelText}" Margin="12,0,6,0"/>
                <ComboBox Grid.Column="10" ItemsSource="{Binding FormatOptions}" SelectedItem="{Binding NewLayoutFormat}" Style="{StaticResource InputBox}"/>
                <Button Grid.Column="11" Content="➕ Aggiungi" Command="{Binding AddProductCommand}" Style="{StaticResource BaseButton}" MinWidth="120"/>
            </Grid>
        </GroupBox>

        <DataGrid Grid.Row="2" ItemsSource="{Binding Products}" SelectedItem="{Binding SelectedProduct}"
                  AutoGenerateColumns="False" CanUserAddRows="False" Margin="0,0,0,10"
                  RowHeight="28" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  ScrollViewer.VerticalScrollBarVisibility="Auto">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="55" IsReadOnly="True"/>
                <DataGridTextColumn Header="Famiglia" Binding="{Binding Famiglia, UpdateSourceTrigger=PropertyChanged}" Width="220"/>
                <DataGridTextColumn Header="Carpenteria" Binding="{Binding Carpenteria, UpdateSourceTrigger=PropertyChanged}" Width="230"/>
                <DataGridTemplateColumn Header="T °C" Width="110">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate><TextBlock Text="{Binding Temperatura}" VerticalAlignment="Center" Padding="6,0"/></DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <ComboBox SelectedItem="{Binding Temperatura, UpdateSourceTrigger=PropertyChanged}"
                                      ItemsSource="{Binding DataContext.TemperatureOptions, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Formato" Width="95">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate><TextBlock Text="{Binding LayoutFormat}" VerticalAlignment="Center" Padding="6,0"/></DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <ComboBox SelectedItem="{Binding LayoutFormat, UpdateSourceTrigger=PropertyChanged}"
                                      ItemsSource="{Binding DataContext.FormatOptions, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Layout DWG" Width="*" MinWidth="420">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding LayoutPathDisplay}" Cursor="Hand" TextDecorations="Underline" VerticalAlignment="Center"
                                       ToolTip="{Binding LayoutPath}" TextTrimming="CharacterEllipsis" Padding="6,0" MouseLeftButtonDown="LayoutPath_Click">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#0078D4"/>
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True"/>
                                                    <Condition Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource AncestorType=DataGrid}}" Value="True"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Foreground" Value="White"/>
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="3" BorderBrush="#DDD" BorderThickness="1,0,0,0" Padding="0,8,0,0">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Button Content="💾 Salva Configurazione" Command="{Binding SaveProductCommand}" Style="{StaticResource BaseButton}" MinWidth="165"/>
                    <Button Content="🗑 Elimina Configurazione" Command="{Binding DeleteProductCommand}" Style="{StaticResource DangerButton}" MinWidth="175"/>
                    <Button Command="{Binding RefreshCommand}" Style="{StaticResource BaseButton}" MinWidth="130">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="⟳" FontSize="15" RenderTransformOrigin="0.5,0.5" Margin="0,0,7,0">
                                <TextBlock.RenderTransform><RotateTransform Angle="0"/></TextBlock.RenderTransform>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRefreshing}" Value="True">
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard x:Name="SpinStoryboard">
                                                        <Storyboard RepeatBehavior="Forever">
                                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.Angle" From="0" To="360" Duration="0:0:0.75"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.EnterActions>
                                                <DataTrigger.ExitActions>
                                                    <RemoveStoryboard BeginStoryboardName="SpinStoryboard"/>
                                                </DataTrigger.ExitActions>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding RefreshButtonText}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
